# PostgreSQL connection (Railway provides this)
DATABASE_URL=postgres://user:password@localhost:5432/superapp

# Optional: Redis connection. Leave empty to run without Redis.
REDIS_URL=

# POS licensing — generate with: node scripts/generate-license-keypair.js
# Private key: server only, never commit. "\n" escapes are fine.
LICENSE_PRIVATE_KEY=

# Secret for the licence admin endpoints / scripts/licenses.js (use a long random string)
ADMIN_API_KEY=

PORT=5000
